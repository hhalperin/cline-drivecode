{
  "$schema": "./canvases.schema.md",
  "$comment": "Registry of design canvases and how each one bundles into a single-file distribution. Adding a canvas here is the whole integration: `bun build-artifact.mjs --all` picks it up. See canvases.schema.md for field meanings.",
  "defaults": {
    "fontsDir": "../../assets/fonts",
    "outDir": "drive-canvas-dist"
  },
  "canvases": {
    "drive-product-demo": {
      "file": "drive-product-demo.html",
      "title": "Drive · product demo",
      "media": {
        "dir": "../../assets/demos/voice",
        "ext": ".mp3",
        "mime": "audio/mpeg",
        "legacyAudioPatch": {
          "baseDecl": "const CLIP_BASE = \"../../assets/demos/voice/\";",
          "call": "new Audio(CLIP_BASE + file)",
          "replacement": "new Audio(VOICE_DATA[file] || CLIP_BASE + file)",
          "mapName": "VOICE_DATA"
        }
      }
    },
    "overview-canvas": {
      "file": "overview-canvas.html",
      "title": "Drive · overview"
    },
    "share-screen-canvas": {
      "file": "share-screen-canvas.html",
      "title": "Drive · share screen"
    },
    "session-satisfaction-moments-canvas": {
      "file": "session-satisfaction-moments-canvas.html",
      "title": "Drive · session satisfaction moments"
    }
  }
}
