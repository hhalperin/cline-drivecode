{
	"name": "@cline/drive",
	"version": "0.0.65",
	"description": "Pure Drive kernel: mode, task bank, loop policy",
	"repository": {
		"type": "git",
		"url": "https://github.com/cline/cline",
		"directory": "sdk/packages/drive"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run bun.mts && bun tsc -p tsconfig.build.json",
		"typecheck": "bun tsc -p tsconfig.dev.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@cline/shared": "workspace:*"
	}
}
