{
	"permissions": {
		"allow": [
			"Bash(cargo check *)",
			"Bash(cargo test)",
			"Bash(cargo test *)",
			"Bash(bun -F @cline/code test:packaged)",
			"Bash(bunx tsc *)",
			"Bash(bunx vitest run *)",
			"mcp__github__get_job_logs",
			"mcp__github__pull_request_read"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/claude-code-for-web-setup.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-pr-merge.py\""
					}
				]
			}
		]
	}
}
